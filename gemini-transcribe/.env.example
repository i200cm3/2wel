# Google AI Studio / Gemini API key
GEMINI_API_KEY=

# Модель с поддержкой аудио
GEMINI_MODEL=gemini-3.5-flash
# При 503/high demand — только flash (pro на free tier часто limit:0)
GEMINI_MODEL_FALLBACKS=gemini-3.6-flash

# Общий секрет с 2wel (Bearer). Сгенерировать: openssl rand -hex 32
GEMINI_TRANSCRIBE_SECRET=

# IP сервера 2wel (опционально). Пусто = достаточно секрета.
GEMINI_TRANSCRIBE_ALLOW_IPS=
# 1 = с валидным Bearer можно вызывать с любого IP (для 2wel и тестов с ноутбука)
GEMINI_TRANSCRIBE_TRUST_SECRET=1

PORT=3100
MAX_AUDIO_BYTES=20971520
DOWNLOAD_TIMEOUT_MS=120000
GEMINI_TIMEOUT_MS=180000

# Опционально: язык и кастомный промпт
# GEMINI_TRANSCRIBE_LANGUAGE=ru
# GEMINI_TRANSCRIBE_PROMPT=
