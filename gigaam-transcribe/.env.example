# Общий секрет с 2wel (Bearer). Сгенерировать: openssl rand -hex 32
# Пусто = без авторизации (только для закрытой LAN).
GIGAAM_TRANSCRIBE_SECRET=

PORT=3200
# Слушать только localhost: GIGAAM_HOST_BIND=127.0.0.1
GIGAAM_HOST_BIND=0.0.0.0
GIGAAM_MODEL=v3_e2e_rnnt
MAX_AUDIO_BYTES=20971520
DOWNLOAD_TIMEOUT_MS=120000

# Кэш весов модели — внутри каталога сервиса (не в git)
GIGAAM_CACHE_DIR=./cache
