# Шаблон окружения. Сюда НЕ класть боевые пароли и API-ключи —
# только плейсхолдеры. Секреты живут в локальном .env (не в git / не в example).
#
# Порт веб-интерфейса на хосте (host nginx → этот порт).
# med=8080, task=8081, phones=8082/8083, anketa=8084, network-map=8085 → promo=8086
PROMO_PORT=8086

# Домен кабинета (TLS на host nginx)
DOMAIN=2wel.ru

# Гостевые ссылки: https://{project-code}.$GUEST_BASE_DOMAIN/xxxx
# Один раз в DNS: A-запись * → IP сервера (wildcard *.2wel.ru).
# Nginx уже слушает *.2wel.ru. SSL для нового поддомена дописывается сам
# при создании объекта/ссылки (ENSURE_GUEST_SSL=1).
GUEST_BASE_DOMAIN=2wel.ru
ENSURE_GUEST_SSL=1
LETSENCRYPT_EMAIL=vitaliy@djinal.ru

# Учётная запись конструктора (/editor). Seed кладёт пользователя в Postgres.
# Если EDITOR_LOGIN без @, email = login@promo.local (вход по почте).
# Локально: changeme ок. На проде — длинный случайный пароль.
EDITOR_LOGIN=admin
EDITOR_PASSWORD=changeme
# openssl rand -hex 32  →  минимум 24 символа, не changeme / change-me-….
AUTH_SECRET=change-me-to-a-long-random-string
# Только локально, пока секрет слабый. На проде не задавать.
# AUTH_ALLOW_INSECURE=1

# Регистрация: open | invite | closed. Для продакшена Джинала — invite.
# Инвайт создаёт только администратор (seed / владелец проекта djinal).
# Пользователя вручную: cd api && npm run user -- --email a@b.c --password 'secret12'
AUTH_REGISTRATION=invite

# Postgres (api поднимает миграции и seed при старте).
# На проде задайте свой POSTGRES_PASSWORD и тот же в DATABASE_URL.
POSTGRES_USER=promo
POSTGRES_PASSWORD=changeme
POSTGRES_DB=promo
POSTGRES_PORT=5432
# Для API вне Docker (локально). В compose хост подменяется на `db`.
DATABASE_URL=postgres://promo:changeme@127.0.0.1:5432/promo

# Публичный origin кабинета (сброс пароля, инвайты). Гостевые ссылки — GUEST_BASE_DOMAIN.
# Если пусто — берётся https://$DOMAIN.
PUBLIC_ORIGIN=

# Письма сброса пароля. Ящик support@2wel.ru на SpaceWeb:
# https://help.sweb.ru/nastrojka-smtp-na-sajte_973.html
# SMTP-сервер smtp.spaceweb.ru, порт 465, SSL. From = тот же ящик, иначе
# «Sender address must be the same as authenticated address».
# Пароль только в .env — сюда не копировать. Смена: панель SpaceWeb → почта.
# В пароле символ $ для Docker Compose пишите удвоенным: $ → $$ (иначе AUTH 535).
SMTP_HOST=smtp.spaceweb.ru
SMTP_PORT=465
SMTP_USER=support@2wel.ru
SMTP_PASS=
MAIL_FROM=support@2wel.ru
# Значения с пробелами — только в кавычках (иначе deploy.sh: «support: command not found»).
MAIL_FROM_NAME=2wel

# amoCRM (одна интеграция 2wel на все объекты). Redirect URI в amo:
# https://2wel.ru/api/v1/amocrm/oauth/callback
AMO_CLIENT_ID=
AMO_CLIENT_SECRET=
# Если пусто — https://$DOMAIN/api/v1/amocrm/oauth/callback (или PUBLIC_ORIGIN).
AMO_REDIRECT_URI=
# Автовыдача ссылки: пусто = без фильтра. «Тест» часто этап внутри воронки → STATUS_IDS.
# AMO_ISSUE_PIPELINE_IDS=3813037
# AMO_ISSUE_STATUS_IDS=87975206

# Транскрибация звонков — локальный GigaAM на 192.168.2.11 (не Gemini/Яндекс).
# 2wel только шлёт URL записи; аудио в облако не уходит.
GIGAAM_TRANSCRIBE_URL=http://192.168.2.11:3200
# Если на GigaAM задан секрет — тот же Bearer. На LAN можно пустым.
GIGAAM_TRANSCRIBE_SECRET=
# GIGAAM_TIMEOUT_MS=180000

# Локальный LLM для extract JSON (Ollama на 2.11). {hello} по-прежнему Gemini/YandexGPT.
LOCAL_LLM_URL=http://192.168.2.11:3201
# LOCAL_LLM_MODEL=assembly
# LOCAL_LLM_SECRET=
# LOCAL_LLM_TIMEOUT_MS=180000

# Сводка/сборка текста через VDS-прослойку Gemini (не STT).
# HTTP: Bearer уходит открытым текстом — на VDS задайте GEMINI_TRANSCRIBE_ALLOW_IPS
# (IP сервера 2wel) и одинаковый секрет здесь и на VDS (openssl rand -hex 32).
# Альтернатива: ключ в админке /app/api (перекрывает .env, идёт напрямую без прокси).
GEMINI_TRANSCRIBE_URL=http://156.229.27.67:3100
GEMINI_TRANSCRIBE_SECRET=
# GEMINI_API_KEY=  — только на VDS (gemini-transcribe/.env), не на 2wel
# GEMINI_MODEL=gemini-3.5-flash
# YANDEX_SPEECHKIT_API_KEY=  — для YandexGPT (сводка), не для STT
# Folder id каталога — обязателен для YandexGPT (сводка/сборка).
# YANDEX_FOLDER_ID=
# YANDEX_GPT_MODEL=yandexgpt-lite

# SaluteSpeech (Сбер). Ключ авторизации из личного кабинета — base64 client_id:client_secret.
# Голоса: developers.sber.ru/docs/ru/salutespeech/guides/synthesis/voices
# Scope: SALUTE_SPEECH_PERS (физлицо) или SALUTE_SPEECH_CORP (юрлицо).
SALUTE_SPEECH_AUTH_KEY=
SALUTE_SPEECH_SCOPE=SALUTE_SPEECH_PERS
SALUTE_SPEECH_VOICE=Nec_24000
# Цепочка Сбера подписана «Russian Trusted Root CA»: без неё TLS не проходит.
SALUTE_SPEECH_CA_FILE=
# Только для локальной отладки, если корневой сертификат ещё не подложен.
# SALUTE_SPEECH_TLS_INSECURE=1

TTS_PROVIDER=elevenlabs

# Синтез через VDS-прослойку (без домена, http://IP:3099). Ключ API только на VDS.
# HTTP: задайте ELEVENLABS_PROXY_ALLOW_IPS на VDS и общий ELEVENLABS_PROXY_SECRET.
# Альтернатива: ключ в админке /app/api (перекрывает .env, идёт напрямую без прокси).
ELEVENLABS_PROXY_URL=http://156.229.27.67:3099
ELEVENLABS_PROXY_SECRET=
# ELEVENLABS_API_KEY=  — не нужен на 2wel, если задан PROXY_URL (только elevenlabs-proxy/.env)
ELEVENLABS_VOICE_ID=ymDCYd8puC7gYjxIamPt
ELEVENLABS_VOICES="ymDCYd8puC7gYjxIamPt|Marina (тёплый, женский),EDpEYNf6XIeKYRzYcx4I|Mariia (спокойный, женский),EXAVITQu4vr4xnSDxMaL|Sarah (мягкий, женский),XrExE9yKIg1WjnnlVkGX|Matilda (дружелюбный, женский),cgSgspJ2msm6clMCkdW9|Jessica (живой, женский),0BcDz9UPwL3MpsnTeUlO|Denis (приятный, мужской),ogi2DyUAKJb7CEdqqvlU|Stanislav (глубокий, мужской),JBFqnCBsd6RMkjVDRZzb|George (тёплый, мужской),pNInz6obpgDQGcFmaJgB|Adam (солидный, мужской),vQxSi2EuaRWwBw3nn6dK|Marat (спокойный, мужской)"
ELEVENLABS_MODEL_ID=eleven_v3
ELEVENLABS_STABILITY=0.55
ELEVENLABS_SIMILARITY_BOOST=0.75
ELEVENLABS_STYLE=0.35
ELEVENLABS_SPEAKER_BOOST=true

# Сколько живёт подписанная ссылка на озвучку в конфиге гостя.
TTS_LINK_TTL_HOURS=24

# Демо с лендинга («Получить демо презентации»): проект + шаблон.
# Шаблон должен быть опубликован. Пустой DEMO_TEMPLATE_CODE → дефолтный шаблон проекта.
# Имя берётся при первой выдаче на email; повторно то же email — та же ссылка, имя не меняется.
DEMO_PROJECT_CODE=adm
DEMO_TEMPLATE_CODE=default
# 1 = без персональной TTS при выдаче (дешевле). 0 = с озвучкой по имени гостя.
DEMO_SKIP_TTS=1
