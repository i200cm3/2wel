    "treatment": {
      "id": "treatment",
      "cues": [
        {
          "id": "cue-treatment-01",
          "text": "Программы с врачебным сопровождением",
          "ttsText": "Здесь есть программы оздоровления и лечения — с сопровождением врача на всём маршруте.",
          "startSec": 0,
          "durationSec": 4.8
        },
        {
          "id": "cue-treatment-02",
          "text": "Консультации, вода и процедуры по плану",
          "ttsText": "В санаторные программы входят консультации специалистов, минеральная вода и процедуры по назначению.",
          "startSec": 4.8,
          "durationSec": 4.8
        },
        {
          "id": "cue-treatment-03",
          "text": "Процедуры — по назначению врача",
          "ttsText": "Процедуры и оборудование подбирают индивидуально — по назначению врача, а не по общему списку.",
          "startSec": 9.6,
          "durationSec": 4.6
        },
        {
          "id": "cue-treatment-04",
          "text": "Сердце, опорно-двигательная, дыхание, ЖКТ",
          "ttsText": "Имеются программы по сердечно-сосудистой системе, опорно-двигательной системе, дыхательной системе, ЖКТ и обмену веществ.",
          "startSec": 14.2,
          "durationSec": 4.8
        },
        {
          "id": "cue-treatment-05",
          "text": "Контроль состояния на каждом этапе",
          "ttsText": "Врачи наблюдают за самочувствием на всём пути программы — от консультации до процедур.",
          "startSec": 19,
          "durationSec": 4.6
        }
