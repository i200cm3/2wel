    "about": {
      "id": "about",
      "cues": [
        {
          "id": "cue-about-01",
          "text": "Пятизвездочный формат без показной строгости",
          "ttsText": "«Плаза СПА» соединяет формат пятизвездочного санатория с ощущением спокойного курортного отдыха.",
          "startSec": 0,
          "durationSec": 5
        },
        {
          "id": "cue-about-02",
          "text": "Интерьеры, в которых легко выдохнуть",
          "ttsText": "Общие зоны и номера здесь выглядят мягко и спокойно, без ощущения больничного режима.",
          "startSec": 5,
          "durationSec": 4.8
        },
        {
          "id": "cue-about-03",
          "text": "СПА и восстановление внутри каждого дня",
          "ttsText": "Бассейн, сауна и привычные зоны восстановления становятся естественной частью каждого дня.",
          "startSec": 9.8,
          "durationSec": 4.8
        },
        {
          "id": "cue-about-04",
          "text": "Разные сценарии проживания без компромисса",
          "ttsText": "Здесь есть варианты размещения и для короткого визита, и для семейного отдыха, и для более длинного восстановления.",
          "startSec": 14.6,
          "durationSec": 5
        }
