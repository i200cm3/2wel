    "food": {
      "id": "food",
      "cues": [
        {
          "id": "cue-food-01",
          "text": "Два ресторана с разным настроением",
          "ttsText": "Здесь два ресторана с разным характером: «Роял» — с авторской кухней, «Панорама» — со шведским столом.",
          "startSec": 0,
          "durationSec": 4.6
        },
        {
          "id": "cue-food-02",
          "text": "Рацион можно встроить в программу",
          "ttsText": "Питание здесь не оторвано от лечения: его можно адаптировать под рекомендации и формат программы.",
          "startSec": 4.6,
          "durationSec": 4.4
        },
        {
          "id": "cue-food-03",
          "text": "Подача аккуратная, без показной роскоши",
          "ttsText": "Блюда выглядят современно и легко, сохраняя ощущение вкуса, а не тяжёлой торжественности.",
          "startSec": 9,
          "durationSec": 4.4
        },
        {
          "id": "cue-food-04",
          "text": "Понятные блюда из хороших продуктов",
          "ttsText": "В основе меню — качественные продукты и понятные блюда, с которыми легко совмещать отдых.",
          "startSec": 13.4,
          "durationSec": 4.2
        },
        {
          "id": "cue-food-05",
          "text": "Еда становится частью общего ритма",
          "ttsText": "Питание здесь воспринимается как естественная часть санаторного дня, а не как отдельная формальность.",
          "startSec": 17.6,
          "durationSec": 4.4
        },
        {
          "id": "cue-food-06",
          "text": "И финал дня тоже может быть красивым",
          "ttsText": "Десерты и лёгкие блюда оставляют ощущение ресторана, в который приятно вернуться вечером.",
          "startSec": 22,
          "durationSec": 4.2
        }
