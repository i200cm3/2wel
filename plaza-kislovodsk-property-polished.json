    "greeting": {
      "id": "greeting",
      "cues": [
        {
          "id": "cue-greeting-01",
          "text": "Ваш отдых в «Плаза СПА»",
          "ttsText": "Здравствуйте, {name}! Сейчас коротко покажем, как устроены отдых и восстановление в санатории «Плаза СПА».",
          "startSec": 0,
          "durationSec": 5.44
        },
        {
          "id": "cue-greeting-02",
          "text": "Спокойный сервис без лишней суеты",
          "ttsText": "Здесь делают ставку на внимательный сервис, понятную заботу и спокойный ритм с первых минут.",
          "startSec": 5.44,
          "durationSec": 4
        },
        {
          "id": "cue-greeting-03",
          "text": "Бассейн, сауна и время выдохнуть",
          "ttsText": "В ежедневный ритм легко встроены бассейн, сауна и восстановление между процедурами.",
          "startSec": 9.44,
          "durationSec": 4.1
        },
        {
          "id": "cue-greeting-04",
          "text": "Номера под короткий и длинный заезд",
          "ttsText": "Можно выбрать формат проживания под короткий визит, семейный отдых или более длинную программу.",
          "startSec": 13.54,
          "durationSec": 4.2
        },
        {
          "id": "cue-greeting-05",
          "text": "Дальше можно посмотреть всё по темам",
          "ttsText": "Дальше выберите раздел и спокойно посмотрите то, что важно именно вам: номера, лечение, питание, досуг или локацию.",
          "startSec": 17.74,
          "durationSec": 4
        }
      ],
