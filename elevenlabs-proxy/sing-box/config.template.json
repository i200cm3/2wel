{
  "log": {
    "level": "info",
    "timestamp": true
  },
  "dns": {
    "servers": [
      {
        "tag": "remote",
        "type": "udp",
        "server": "1.1.1.1"
      },
      {
        "tag": "local",
        "type": "local"
      }
    ],
    "rules": [
      {
        "domain_suffix": ["elevenlabs.io", "googleapis.com"],
        "server": "remote"
      }
    ],
    "final": "local"
  },
  "inbounds": [
    {
      "type": "tun",
      "tag": "tun-in",
      "interface_name": "sb-tun",
      "address": ["172.19.0.1/30"],
      "auto_route": true,
      "strict_route": true,
      "route_address": [
        "34.8.184.191/32",
        "34.54.252.193/32",
        "34.36.213.91/32",
        "216.198.53.6/32",
        "216.198.54.6/32"
      ]
    },
    {
      "type": "socks",
      "tag": "socks-in",
      "listen": "127.0.0.1",
      "listen_port": 38182
    }
  ],
  "outbounds": [
    {
      "type": "direct",
      "tag": "direct"
    }
  ],
  "endpoints": [
    {
      "type": "wireguard",
      "tag": "eleven-proxy",
      "system": false,
      "mtu": 1280,
      "address": ["172.16.0.2/32"],
      "private_key": "WARP_PRIVATE_KEY",
      "peers": [
        {
          "address": "engage.cloudflareclient.com",
          "port": 2408,
          "public_key": "WARP_PEER_PUBLIC_KEY",
          "allowed_ips": ["0.0.0.0/0", "::/0"],
          "reserved": [0, 0, 0],
          "persistent_keepalive_interval": 25
        }
      ]
    }
  ],
  "route": {
    "auto_detect_interface": true,
    "default_domain_resolver": "remote",
    "rules": [
      {
        "action": "sniff"
      },
      {
        "inbound": ["socks-in"],
        "outbound": "eleven-proxy"
      },
      {
        "domain_suffix": ["elevenlabs.io", "googleapis.com"],
        "outbound": "eleven-proxy"
      },
      {
        "ip_cidr": [
          "34.8.184.191/32",
          "34.54.252.193/32",
          "34.36.213.91/32",
          "216.198.53.6/32",
          "216.198.54.6/32"
        ],
        "outbound": "eleven-proxy"
      }
    ],
    "final": "direct"
  }
}
