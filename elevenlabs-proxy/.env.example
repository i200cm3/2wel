# ElevenLabs API — только на этом VDS
ELEVENLABS_API_KEY=

# Общий секрет с 2wel.ru (Bearer). Сгенерировать: openssl rand -hex 32
ELEVENLABS_PROXY_SECRET=

# IP сервера 2wel (опционально). Пусто = достаточно секрета.
ELEVENLABS_PROXY_ALLOW_IPS=
# 1 = с валидным Bearer секретом можно синтезировать с любого IP (для генерации демо с ноутбука)
# ELEVENLABS_PROXY_TRUST_SECRET=1

PORT=3099
ELEVENLABS_MODEL_ID=eleven_v3
ELEVENLABS_STABILITY=0.55
ELEVENLABS_SIMILARITY_BOOST=0.75
ELEVENLABS_STYLE=0.35
